# Cookiebot CMP domain group identifier (CBID)
# Example format: 11111111-2222-3333-4444-555555555555
PUBLIC_COOKIEBOT_CBID="00000000-0000-0000-0000-000000000000"

# Google Analytics 4 web stream measurement ID
# Found in Google Analytics -> Admin -> Data streams -> Web stream
# Example format: G-ABC123DEF4
PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Meta Pixel / dataset ID
# Found in Meta Events Manager
# Example format: 123456789012345
PUBLIC_META_PIXEL_ID="123456789012345"
