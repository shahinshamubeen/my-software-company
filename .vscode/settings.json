{
  // ===== IMPORTANT: Disable false-positive linter warnings for React/Astro =====
  // These linters cannot understand JSX expressions like aria-invalid={condition ? "true" : "false"}
  // The code is correct - the linters are wrong for React projects

  // Disable HTML validation entirely for JSX/TSX files (they're not HTML!)
  "html.validate.scripts": false,
  "html.validate.styles": false,
  
  // Disable CSS validation (we use Tailwind)
  "css.validate": false,
  "css.lint.important": "ignore",
  
  // Disable accessibility linting that doesn't understand React
  "axe-linter.rules": {
    "aria-valid-attr-value": false,
    "label": false
  },
  
  // HTMLHint settings - disable inline style rule
  "htmlhint.enable": false,
  "htmlhint.options": {
    "inline-style-disabled": false,
    "attr-value-double-quotes": false
  },
  
  // Webhint settings
  "webhint.enableTelemetry": "disabled",
  
  // Web Accessibility extension - disable
  "webAccessibility.enable": false,
  
  // ===== Tailwind CSS settings =====
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.validate": true,
  
  // ===== TypeScript/Astro settings =====
  "typescript.tsdk": "node_modules/typescript/lib",
  
  // ===== Editor settings =====
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  
  // ===== File associations =====
  "files.associations": {
    "*.astro": "astro"
  }
}
