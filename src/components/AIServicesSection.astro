---
// How we use AI to deliver better results for clients
const capabilities = [
  {
    icon: "rocket",
    title: "Faster Time-to-Market",
    description: "We use AI-assisted development and automation to ship your product faster without compromising quality.",
    stat: "40%",
    statLabel: "faster delivery",
  },
  {
    icon: "brain",
    title: "Smarter Products",
    description: "From intelligent search to personalized recommendations, we build AI features that make your product stand out.",
    stat: "3x",
    statLabel: "user engagement",
  },
  {
    icon: "shield",
    title: "Scalable Architecture",
    description: "Our battle-tested infrastructure patterns handle millions of users, with intelligent load balancing and caching.",
    stat: "99.9%",
    statLabel: "uptime",
  },
  {
    icon: "lightning",
    title: "Intelligent Automation",
    description: "We automate repetitive tasks in your workflows, freeing your team to focus on what matters most.",
    stat: "10x",
    statLabel: "efficiency gains",
  },
];

const icons: Record<string, string> = {
  rocket: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`,
  brain: `<path d="M12 2a4 4 0 0 1 4 4v1a4 4 0 0 1-1 2.65V11a3 3 0 0 1 3 3v1a3 3 0 0 1-3 3h-1v2a2 2 0 0 1-4 0v-2H9a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3V9.65A4 4 0 0 1 8 7V6a4 4 0 0 1 4-4z" /><circle cx="9" cy="7" r="1" fill="currentColor" /><circle cx="15" cy="7" r="1" fill="currentColor" />`,
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>`,
  lightning: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`,
};
---

<section class="py-24 relative overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-gradient-to-b from-obsidian via-carbon to-obsidian"></div>
  
  <div class="section-container relative z-10">
    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full">
        How We Deliver
      </span>
      <h2 class="text-display-md font-display font-bold text-white mb-4">
        Technology That Works For You
      </h2>
      <p class="max-w-2xl mx-auto text-white/60">
        We leverage the latest technologies—including AI—to build software that's 
        smarter, faster, and more efficient. Here's what that means for your project.
      </p>
    </div>

    <!-- Capabilities Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {capabilities.map((item) => (
        <div class="group p-8 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-cyber-lime/30 transition-all duration-300">
          <div class="flex items-start gap-6">
            <!-- Icon -->
            <div class="w-14 h-14 rounded-xl bg-cyber-lime/10 border border-cyber-lime/20 flex items-center justify-center shrink-0 group-hover:bg-cyber-lime/20 transition-colors">
              <svg 
                class="w-7 h-7 text-cyber-lime" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <Fragment set:html={icons[item.icon]} />
              </svg>
            </div>
            
            <!-- Content -->
            <div class="flex-1">
              <h3 class="text-xl font-display font-semibold text-white mb-2 group-hover:text-cyber-lime transition-colors">
                {item.title}
              </h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">
                {item.description}
              </p>
              
              <!-- Stat -->
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-bold font-mono text-cyber-lime">
                  {item.stat}
                </span>
                <span class="text-sm text-white/40 uppercase tracking-wide">
                  {item.statLabel}
                </span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <p class="text-white/50 mb-6">
        Ready to build something exceptional?
      </p>
      <a
        href="/services"
        class="inline-flex items-center gap-2 px-6 py-3 bg-cyber-lime text-obsidian font-semibold rounded-lg hover:bg-cyber-lime/90 transition-colors group"
      >
        Explore Our Services
        <svg
          class="w-5 h-5 transition-transform group-hover:translate-x-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12 5 19 12 12 19" />
        </svg>
      </a>
    </div>
  </div>
</section>
