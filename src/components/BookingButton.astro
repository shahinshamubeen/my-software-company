---
// BookingButton.astro
// Pure HTML/CSS/Vanilla JS implementation of the booking modal
---

<button
  id="open-booking-modal"
  class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-electric-indigo/20 border border-electric-indigo/30 text-electric-indigo hover:bg-electric-indigo hover:text-white transition-all duration-300"
>
  <svg
    class="w-5 h-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
    <line x1="16" y1="2" x2="16" y2="6" />
    <line x1="8" y1="2" x2="8" y2="6" />
    <line x1="3" y1="10" x2="21" y2="10" />
  </svg>
  <span class="font-medium">Book a Call</span>
</button>

<dialog
  id="booking-modal"
  class="backdrop:bg-obsidian/80 backdrop:backdrop-blur-sm bg-transparent w-full max-w-lg p-0 m-auto rounded-2xl shadow-2xl transition-[opacity,transform] duration-300"
  aria-labelledby="booking-modal-title"
>
  <div class="bg-carbon border border-glass-border rounded-2xl overflow-hidden w-full">
    <!-- Header -->
    <div class="flex items-center justify-between p-6 border-b border-glass-border">
      <div>
        <h2
          id="booking-modal-title"
          class="text-xl font-display font-bold text-white relative z-10"
        >
          Schedule a Call
        </h2>
        <p class="text-sm text-white/60 mt-1">
          Book a 30-minute intro call with our team
        </p>
      </div>
      <button
        id="close-booking-modal"
        class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-white/60 hover:text-white hover:border-white/20 transition-all cursor-pointer"
        aria-label="Close modal"
      >
        <svg
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <!-- Content -->
    <div class="p-6">
      <!-- Time slot selection -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-white mb-3">
          Select a time slot
        </label>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <p class="text-xs text-white/50 mb-2">Tomorrow</p>
            <div class="space-y-2">
              <button class="w-full px-3 py-2 rounded-lg border border-white/10 text-sm text-white/80 hover:border-cyber-lime hover:text-cyber-lime transition-all cursor-pointer">
                10:00 AM
              </button>
              <button class="w-full px-3 py-2 rounded-lg border border-white/10 text-sm text-white/80 hover:border-cyber-lime hover:text-cyber-lime transition-all cursor-pointer">
                2:00 PM
              </button>
            </div>
          </div>
          <div>
            <p class="text-xs text-white/50 mb-2">Thu, Jan 2</p>
            <div class="space-y-2">
              <button class="w-full px-3 py-2 rounded-lg border border-white/10 text-sm text-white/80 hover:border-cyber-lime hover:text-cyber-lime transition-all cursor-pointer">
                11:00 AM
              </button>
              <button class="w-full px-3 py-2 rounded-lg border border-white/10 text-sm text-white/80 hover:border-cyber-lime hover:text-cyber-lime transition-all cursor-pointer">
                3:00 PM
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Or use external calendar -->
      <div class="relative">
        <div class="absolute inset-0 flex items-center">
          <div class="w-full border-t border-glass-border"></div>
        </div>
        <div class="relative flex justify-center">
          <span class="px-4 bg-carbon text-sm text-white/40">or</span>
        </div>
      </div>

      <!-- External booking links -->
      <div class="mt-6 space-y-3">
        <a
          href="https://calendly.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white hover:border-cyber-lime/50 hover:bg-cyber-lime/5 transition-all"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z" />
          </svg>
          <span>Open Calendly</span>
          <svg
            class="w-4 h-4 ml-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>

        <a
          href="https://cal.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-lg bg-white/5 border border-white/10 text-white hover:border-electric-indigo/50 hover:bg-electric-indigo/5 transition-all"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
          </svg>
          <span>Open Cal.com</span>
          <svg
            class="w-4 h-4 ml-auto"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
        </a>
      </div>

      <!-- Email alternative -->
      <p class="mt-6 text-center text-sm text-white/50">
        Prefer email?{" "}
        <a href="mailto:hello@wydgt.dev" class="text-cyber-lime hover:underline">
          hello@wydgt.dev
        </a>
      </p>
    </div>
  </div>
</dialog>

<style>
  dialog {
    opacity: 0;
    transform: scale(0.95) translateY(20px);
    display: flex;
  }
  
  /* The dialog element doesn't render unless it has the [open] attribute */
  dialog:not([open]) {
    display: none;
  }
  
  dialog[open] {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
  
  dialog::backdrop {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  dialog[open]::backdrop {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('booking-modal') as HTMLDialogElement;
    const openBtn = document.getElementById('open-booking-modal');
    const closeBtn = document.getElementById('close-booking-modal');

    // Open modal
    openBtn?.addEventListener('click', () => {
      modal?.showModal();
    });

    // Close modal via button
    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    // Close modal via backdrop click
    modal?.addEventListener('click', (e) => {
      const dialogDimensions = modal.getBoundingClientRect()
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    });
  });
</script>
