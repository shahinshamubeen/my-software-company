---
const cards = [
  {
    title: "For Startups",
    description: "Move at the speed your runway demands. Get senior engineers on your product from week one - no equity, no long-term contracts, no HR overhead.",
    icon: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`
  },
  {
    title: "For Scale-Ups",
    description: "Your core team is stretched. Augment with specialists - cloud architects, AI engineers, mobile developers. They integrate into your existing workflows from day one.",
    icon: `<polyline stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="16 7 22 7 22 13"/>`
  },
  {
    title: "For Established Businesses",
    description: "Outsource an entire product squad. PM, tech lead, developers, and QA - fully managed, with weekly reporting and complete accountability.",
    icon: `<rect stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="4" y="2" width="16" height="20" rx="2" ry="2"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 22v-4h6v4"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 6h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 10h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 14h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14h.01"/>`
  }
];
---

<section id="dedicated-team" class="py-24 relative overflow-hidden bg-obsidian">
  <div class="absolute inset-0 grid-lines opacity-10" aria-hidden="true"></div>
  
  <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[40rem] h-[40rem] bg-electric-indigo/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="section-container relative z-10 text-center">
    <div class="max-w-4xl mx-auto mb-16">
      <span class="inline-block px-4 py-1 mb-6 text-xs font-mono uppercase tracking-widest text-electric-indigo border border-electric-indigo/30 rounded-full">
        Dedicated Development Team
      </span>
      <h2 class="text-display-md font-display font-bold text-white mb-6 leading-tight">
        Your Engineering Team. Ready in Days, Not Months.
      </h2>
      <p class="text-lg text-white/70 max-w-3xl mx-auto leading-relaxed">
        Skip the 6-month hiring process. Get a dedicated software development team that works as a true extension of your business.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {cards.map((card) => (
        <div class="group relative rounded-2xl border border-white/10 bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-2 hover:bg-white/[0.04] hover:border-electric-indigo/30 flex flex-col items-center">
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-electric-indigo/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
          
          <div class="relative z-10 flex flex-col items-center">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-electric-indigo/10 text-electric-indigo mb-6 transition-transform duration-500 group-hover:scale-110 group-hover:bg-electric-indigo/20">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <Fragment set:html={card.icon} />
              </svg>
            </div>
            
            <h3 class="text-xl font-display font-semibold text-white mb-4 group-hover:text-electric-indigo transition-colors duration-300">
              {card.title}
            </h3>
            
            <p class="text-sm leading-relaxed text-white/60">
              {card.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
