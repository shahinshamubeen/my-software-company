---
import HeroCanvas from "./HeroCanvas";
import KineticHeadline from "./KineticHeadline";
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <!-- Background Gradient -->
  <div
    class="absolute inset-0 bg-gradient-radial from-carbon via-obsidian to-obsidian"
    aria-hidden="true"
  >
  </div>

  <!-- Grid Lines Overlay -->
  <div class="absolute inset-0 grid-lines opacity-20" aria-hidden="true"></div>

  <!-- Three.js Canvas (Lazy-loaded Island) -->
  <div class="absolute inset-0 z-0">
    <HeroCanvas client:visible />
  </div>

  <!-- Hero Content -->
  <div class="relative z-10 section-container text-center pointer-events-none">
    <!-- Eyebrow Tag -->
    <div
      id="hero-eyebrow"
      class="inline-flex items-center gap-2 px-4 py-2 mb-6 glass-card text-sm font-mono text-cyber-lime opacity-0 translate-y-8 pointer-events-auto"
    >
      <span class="w-2 h-2 bg-cyber-lime rounded-full animate-pulse"></span>
      <span>SOFTWARE DEVELOPMENT AGENCY</span>
    </div>

    <!-- Main Headline with Kinetic Typography -->
    <div class="pointer-events-auto">
      <KineticHeadline client:idle />
    </div>

    <!-- Subheadline -->
    <p
      id="hero-subheadline"
      class="max-w-2xl mx-auto mt-6 text-lg sm:text-xl text-white/70 leading-relaxed opacity-0 translate-y-8 pointer-events-auto"
    >
      We transform ambitious ideas into
      <span class="text-cyber-lime">market-leading digital products</span>. From
      concept to scale, we engineer solutions that define industries.
    </p>

    <!-- CTA Buttons -->
    <div
      id="hero-ctas"
      class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-10 pointer-events-auto opacity-0 translate-y-8"
    >
      <a href="/work" class="btn-brutal text-lg group">
        <span class="flex items-center gap-2">
          View Our Work
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 h-5 transition-transform group-hover:translate-x-1"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </a>
      <a href="/contact" class="btn-outline text-lg"> Start a Project </a>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div
    id="hero-scroll"
    class="absolute bottom-24 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/60 pointer-events-auto opacity-0 translate-y-4"
  >
    <span class="text-xs uppercase tracking-widest">Scroll</span>
    <div
      class="w-px h-8 bg-gradient-to-b from-white/60 to-transparent animate-pulse"
    >
    </div>
  </div>
</section>

<style>
  .bg-gradient-radial {
    background: radial-gradient(
      ellipse at center,
      var(--color-carbon) 0%,
      var(--color-obsidian) 70%
    );
  }

  .stat-item {
    position: relative;
  }

  .stat-item::after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  .stat-item:hover::after {
    width: 100%;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("DOMContentLoaded", () => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const eyebrow = document.getElementById("hero-eyebrow");
    const subheadline = document.getElementById("hero-subheadline");
    const ctas = document.getElementById("hero-ctas");
    const scroll = document.getElementById("hero-scroll");

    if (prefersReducedMotion) {
      if (eyebrow) { eyebrow.classList.remove("opacity-0", "translate-y-8"); }
      if (subheadline) { subheadline.classList.remove("opacity-0", "translate-y-8"); }
      if (ctas) { ctas.classList.remove("opacity-0", "translate-y-8"); }
      if (scroll) { scroll.classList.remove("opacity-0", "translate-y-4"); }
      return;
    }

    const animateElements = () => {
      // Small delays relative to the headline animation which starts immediately upon canvas-ready
      if (eyebrow) gsap.to(eyebrow, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 0 });
      if (subheadline) gsap.to(subheadline, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 0.3 });
      if (ctas) gsap.to(ctas, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 0.5 });
      if (scroll) gsap.to(scroll, { opacity: 1, y: 0, duration: 1, ease: "power3.out", delay: 1.2 });
    };

    let animationStarted = false;
    const onCanvasReady = () => {
      if (animationStarted) return;
      animationStarted = true;
      animateElements();
    };

    window.addEventListener("canvas-ready", onCanvasReady);
    
    // Fallback if event is missed or doesn't fire
    setTimeout(onCanvasReady, 1500);
  });
</script>
