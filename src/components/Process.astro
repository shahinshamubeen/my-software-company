---
const steps = [
  {
    number: "1",
    title: "Discovery Call",
    description: "We start with a 30-minute call - no pitch deck, no sales script. We ask the right questions to understand your business, pain points, and goals. Honest conversation about whether we're the right fit.",
    icon: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v4m0 12v4M2 12h4m12 0h4m-3.5-7.5L16 7M8 17l-2.5 2.5M4.5 4.5 7 7m10 10 2.5 2.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>`
  },
  {
    number: "2",
    title: "Strategy & Proposal",
    description: "Based on the discovery, we put together a tailored proposal - technology recommendation, timeline, team composition, and cost. You see the full picture before committing to anything.",
    icon: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>`
  },
  {
    number: "3",
    title: "Build & Ship",
    description: "We get to work. Weekly check-ins, continuous deployment, and full visibility into progress via your preferred tools - Slack, Jira, Teams. You're never left wondering what's happening.",
    icon: `<polyline stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="16 18 22 12 16 6"/><polyline stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="8 6 2 12 8 18"/>`
  },
  {
    number: "4",
    title: "Scale & Evolve",
    description: "After launch, we don't disappear. We monitor, optimise, and scale with you. Most clients continue with us long after the initial project - because the work doesn't stop at go-live.",
    icon: `<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 13 3-3 3 3"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10v9"/>`
  }
];
---

<section id="process" class="py-24 relative overflow-hidden bg-gradient-to-b from-void to-obsidian">
  <div class="absolute inset-0 grid-lines opacity-10" aria-hidden="true"></div>
  
  <div class="section-container relative z-10">
    <div class="max-w-4xl mb-16">
      <div class="flex items-center gap-2 mb-6">
        <div class="h-2 w-2 rounded-full bg-electric-indigo"></div>
        <span class="text-xs font-mono uppercase tracking-widest text-electric-indigo">
          Our 4-Step Process
        </span>
      </div>
      <h2 class="text-display-md font-display font-bold text-white mb-6 leading-tight max-w-2xl">
        Simple, Transparent, Results-Driven
      </h2>
      <p class="text-lg text-white/70 max-w-3xl leading-relaxed">
        No surprises. No scope creep. No ghosting after kickoff. A clear process from day one - with clear milestones, clear ownership, and clear outcomes.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step) => (
        <div class="group relative rounded-2xl border border-white/10 bg-white/[0.02] p-8 transition-all duration-500 hover:-translate-y-2 hover:bg-white/[0.04] hover:border-white/20 flex flex-col h-full overflow-hidden">
          <div class="absolute -right-4 -top-8 text-9xl font-display font-bold text-white/[0.03] transition-colors duration-500 group-hover:text-electric-indigo/10 z-0 pointer-events-none select-none">
            {step.number}
          </div>
          
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-electric-indigo/5 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100 pointer-events-none" aria-hidden="true"></div>
          
          <div class="relative z-10 flex-grow flex flex-col items-center text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/[0.05] text-white/80 mb-6 transition-all duration-500 group-hover:bg-electric-indigo/20 group-hover:text-electric-indigo group-hover:scale-110">
              <svg
                class="h-8 w-8"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <Fragment set:html={step.icon} />
              </svg>
            </div>
            
            <h3 class="text-xl font-display font-semibold text-white mb-4 group-hover:text-electric-indigo transition-colors duration-300">
              {step.title}
            </h3>
            
            <p class="text-sm leading-relaxed text-white/60">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
