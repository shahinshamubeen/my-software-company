---
import Layout from "../layouts/Layout.astro";

// Popular pages for suggestions
const popularPages = [
  { label: "Home", href: "/", description: "Back to the main page" },
  { label: "Work", href: "/work", description: "View our portfolio" },
  { label: "Services", href: "/services", description: "What we offer" },
  { label: "Contact", href: "/contact", description: "Get in touch" },
];
---

<Layout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <section class="min-h-screen flex items-center justify-center py-24">
    <div class="section-container">
      <div class="max-w-2xl mx-auto text-center">
        {/* Glitchy 404 */}
        <div class="relative mb-8">
          <span
            class="block text-[12rem] sm:text-[16rem] font-display font-bold leading-none text-transparent bg-clip-text bg-gradient-to-r from-cyber-lime via-electric-indigo to-electric-purple glitch-text"
            aria-hidden="true"
          >
            404
          </span>
          {/* Glitch layers */}
          <span
            class="absolute inset-0 text-[12rem] sm:text-[16rem] font-display font-bold leading-none text-cyber-lime/20 glitch-layer-1"
            aria-hidden="true"
          >
            404
          </span>
          <span
            class="absolute inset-0 text-[12rem] sm:text-[16rem] font-display font-bold leading-none text-electric-indigo/20 glitch-layer-2"
            aria-hidden="true"
          >
            404
          </span>
        </div>

        {/* Message */}
        <h1 class="text-3xl sm:text-4xl font-display font-bold text-white mb-4">
          Page Not Found
        </h1>
        <p class="text-lg text-white/70 mb-8">
          Looks like you've ventured into the void. The page you're looking for
          doesn't exist or has been moved.
        </p>

        {/* Search hint */}
        <div
          class="inline-flex items-center gap-2 px-4 py-2 mb-12 glass-card text-sm font-mono text-white/60"
        >
          <span class="text-cyber-lime">$</span>
          <span>cd /home && find . -name "page"</span>
          <span class="animate-pulse">_</span>
        </div>

        {/* Action buttons */}
        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16"
        >
          <a href="/" class="btn-brutal">
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              Go Home
            </span>
          </a>
          <button onclick="history.back()" class="btn-outline">
            <span class="flex items-center gap-2">
              <svg
                class="w-5 h-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
              Go Back
            </span>
          </button>
        </div>

        {/* Popular pages */}
        <div>
          <h2
            class="text-sm font-mono uppercase tracking-widest text-white/40 mb-6"
          >
            Popular Pages
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {
              popularPages.map((page) => (
                <a
                  href={page.href}
                  class="group p-4 rounded-xl glass-card border border-glass-border hover:border-cyber-lime/30 transition-all duration-300"
                >
                  <span class="block text-white font-medium group-hover:text-cyber-lime transition-colors">
                    {page.label}
                  </span>
                  <span class="text-xs text-white/50">{page.description}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Animated background */}
  <div class="fixed inset-0 pointer-events-none z-0" aria-hidden="true">
    <div
      class="absolute inset-0 bg-gradient-radial from-electric-indigo/5 via-transparent to-transparent opacity-50"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-cyber-lime/5 rounded-full blur-3xl"
    >
    </div>
  </div>
</Layout>

<style>
  .bg-gradient-radial {
    background: radial-gradient(
      ellipse at center,
      var(--tw-gradient-from),
      var(--tw-gradient-via),
      var(--tw-gradient-to)
    );
  }

  /* Glitch effect */
  .glitch-text {
    animation: glitch 2s infinite;
  }

  .glitch-layer-1 {
    animation: glitch-1 2s infinite;
  }

  .glitch-layer-2 {
    animation: glitch-2 2s infinite;
  }

  @keyframes glitch {
    0%,
    90%,
    100% {
      transform: none;
    }
    92% {
      transform: skew(-2deg);
    }
    94% {
      transform: skew(2deg);
    }
    96% {
      transform: skew(-1deg);
    }
    98% {
      transform: skew(1deg);
    }
  }

  @keyframes glitch-1 {
    0%,
    90%,
    100% {
      transform: translate(0);
      opacity: 0;
    }
    92% {
      transform: translate(-4px, -2px);
      opacity: 1;
    }
    94% {
      transform: translate(4px, 2px);
      opacity: 1;
    }
    96% {
      transform: translate(-2px, 1px);
      opacity: 0.5;
    }
    98% {
      transform: translate(2px, -1px);
      opacity: 0;
    }
  }

  @keyframes glitch-2 {
    0%,
    90%,
    100% {
      transform: translate(0);
      opacity: 0;
    }
    91% {
      transform: translate(4px, 2px);
      opacity: 1;
    }
    93% {
      transform: translate(-4px, -2px);
      opacity: 1;
    }
    95% {
      transform: translate(2px, -1px);
      opacity: 0.5;
    }
    97% {
      transform: translate(-2px, 1px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glitch-text,
    .glitch-layer-1,
    .glitch-layer-2 {
      animation: none;
    }
  }
</style>
