---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { blogPosts, categories, getFeaturedPosts } from "../data/blogPosts";

const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Blog" },
];

const featuredPosts = getFeaturedPosts();
const regularPosts = blogPosts.filter(post => !post.featured);

// Format date helper
function formatDate(dateString: string) {
    return new Date(dateString).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    });
}
---

<Layout title="Blog" description="Insights on software development, AI, design systems, and building successful tech products. From the team at Apex Labs.">
    {/* Hero */}
    <section class="pt-32 pb-16 relative overflow-hidden">
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-20 left-1/3 w-96 h-96 bg-electric-indigo/20 rounded-full blur-3xl"></div>
            <div class="absolute bottom-10 right-1/4 w-64 h-64 bg-electric-purple/20 rounded-full blur-3xl"></div>
        </div>

        <div class="section-container relative z-10">
            <Breadcrumb items={breadcrumbItems} />
            
            <div class="max-w-3xl">
                <span class="inline-block px-4 py-1 mb-6 text-xs font-mono uppercase tracking-widest text-electric-indigo border border-electric-indigo/30 rounded-full">
                    Insights & Ideas
                </span>
                
                <h1 class="text-display-xl font-display font-bold text-white mb-6">
                    The Apex Labs Blog
                </h1>
                
                <p class="text-xl text-white/60">
                    Thoughts on building great software, from engineering architecture to design systems to AI. 
                    Written by our team of builders.
                </p>
            </div>
        </div>
    </section>

    {/* Categories */}
    <section class="py-8 border-y border-glass-border">
        <div class="section-container">
            <div class="flex flex-wrap items-center gap-3">
                <span class="text-sm text-white/40 mr-2">Filter by:</span>
                <button 
                    class="px-4 py-2 text-sm font-medium text-cyber-lime bg-cyber-lime/10 border border-cyber-lime/30 rounded-full transition-all category-btn active"
                    data-category="all"
                >
                    All Posts
                </button>
                {categories.map((category) => (
                    <button 
                        class="px-4 py-2 text-sm font-medium text-white/60 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-full transition-all category-btn"
                        data-category={category}
                    >
                        {category}
                    </button>
                ))}
            </div>
        </div>
    </section>

    {/* Featured Posts */}
    {featuredPosts.length > 0 && (
        <section class="py-16 featured-section">
            <div class="section-container">
                <h2 class="text-2xl font-display font-bold text-white mb-8 flex items-center gap-3">
                    <svg class="w-6 h-6 text-cyber-lime" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    Featured Articles
                </h2>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    {featuredPosts.map((post, index) => (
                        <a 
                            href={`/blog/${post.id}`}
                            class={`group block rounded-2xl overflow-hidden glass-card border border-glass-border hover:border-cyber-lime/30 transition-all blog-card ${index === 0 ? 'lg:col-span-2' : ''}`}
                            data-category={post.category}
                        >
                            <div class={`${index === 0 ? 'flex flex-col md:flex-row' : ''}`}>
                                {/* Image placeholder */}
                                <div class={`relative overflow-hidden ${index === 0 ? 'md:w-1/2 aspect-video md:aspect-auto' : 'aspect-video'}`}>
                                    <div 
                                        class="absolute inset-0 bg-gradient-to-br from-electric-indigo/20 to-electric-purple/20"
                                    ></div>
                                    <div class="absolute inset-0 grid-lines opacity-30"></div>
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <span class="text-6xl font-display font-bold text-white/10">
                                            {post.title.split(' ')[0]}
                                        </span>
                                    </div>
                                    <div class="absolute top-4 left-4">
                                        <span class="px-3 py-1 text-xs font-mono uppercase tracking-widest text-cyber-lime bg-obsidian/80 backdrop-blur-sm border border-cyber-lime/30 rounded-full">
                                            Featured
                                        </span>
                                    </div>
                                </div>

                                {/* Content */}
                                <div class={`p-6 ${index === 0 ? 'md:w-1/2 md:p-8 flex flex-col justify-center' : ''}`}>
                                    <div class="flex items-center gap-3 mb-3">
                                        <span class="text-sm text-electric-indigo font-medium">
                                            {post.category}
                                        </span>
                                        <span class="text-white/30">·</span>
                                        <span class="text-sm text-white/50">
                                            {post.readTime}
                                        </span>
                                    </div>

                                    <h3 class={`font-display font-bold text-white group-hover:text-cyber-lime transition-colors mb-3 ${index === 0 ? 'text-2xl md:text-3xl' : 'text-xl'}`}>
                                        {post.title}
                                    </h3>

                                    <p class="text-white/60 mb-4 line-clamp-2">
                                        {post.excerpt}
                                    </p>

                                    <div class="flex items-center gap-3 mt-auto">
                                        <div class="w-8 h-8 rounded-full bg-electric-indigo/20 flex items-center justify-center text-electric-indigo text-sm font-bold">
                                            {post.author.name.split(' ').map(n => n[0]).join('')}
                                        </div>
                                        <div>
                                            <span class="text-sm text-white font-medium">{post.author.name}</span>
                                            <span class="text-sm text-white/40 block">{formatDate(post.publishedAt)}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    )}

    {/* All Posts */}
    <section class="py-16 border-t border-glass-border">
        <div class="section-container">
            <h2 class="text-2xl font-display font-bold text-white mb-8">
                All Articles
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="blog-grid">
                {blogPosts.map((post) => (
                    <a 
                        href={`/blog/${post.id}`}
                        class="group block rounded-xl overflow-hidden glass-card border border-glass-border hover:border-white/20 transition-all blog-card"
                        data-category={post.category}
                    >
                        {/* Image placeholder */}
                        <div class="relative aspect-video overflow-hidden">
                            <div 
                                class="absolute inset-0 bg-gradient-to-br from-white/5 to-white/10"
                            ></div>
                            <div class="absolute inset-0 grid-lines opacity-20"></div>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <span class="text-4xl font-display font-bold text-white/10 group-hover:text-white/20 transition-colors">
                                    {post.title.split(' ')[0]}
                                </span>
                            </div>
                        </div>

                        {/* Content */}
                        <div class="p-5">
                            <div class="flex items-center gap-3 mb-3">
                                <span class="text-xs font-mono uppercase tracking-wide text-electric-indigo">
                                    {post.category}
                                </span>
                                <span class="text-white/30">·</span>
                                <span class="text-xs text-white/50">
                                    {post.readTime}
                                </span>
                            </div>

                            <h3 class="text-lg font-display font-semibold text-white group-hover:text-cyber-lime transition-colors mb-2 line-clamp-2">
                                {post.title}
                            </h3>

                            <p class="text-sm text-white/60 mb-4 line-clamp-2">
                                {post.excerpt}
                            </p>

                            {/* Tags */}
                            <div class="flex flex-wrap gap-2 mb-4">
                                {post.tags.slice(0, 3).map((tag) => (
                                    <span class="px-2 py-0.5 text-xs text-white/50 bg-white/5 rounded">
                                        {tag}
                                    </span>
                                ))}
                            </div>

                            <div class="flex items-center justify-between pt-4 border-t border-glass-border">
                                <div class="flex items-center gap-2">
                                    <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-white/60 text-xs font-bold">
                                        {post.author.name.split(' ').map(n => n[0]).join('')}
                                    </div>
                                    <span class="text-xs text-white/50">{post.author.name}</span>
                                </div>
                                <span class="text-xs text-white/40">
                                    {formatDate(post.publishedAt)}
                                </span>
                            </div>
                        </div>
                    </a>
                ))}
            </div>

            {/* Empty state for filtered results */}
            <div id="no-results" class="hidden text-center py-16">
                <svg class="w-16 h-16 mx-auto mb-4 text-white/20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="text-xl font-display font-semibold text-white mb-2">No posts found</h3>
                <p class="text-white/60">No articles match this category yet. Check back soon!</p>
            </div>
        </div>
    </section>

    {/* Newsletter CTA */}
    <section class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian">
        <div class="section-container">
            <div class="max-w-2xl mx-auto text-center">
                <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-cyber-lime/10 border border-cyber-lime/30 flex items-center justify-center">
                    <svg class="w-8 h-8 text-cyber-lime" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                </div>

                <h2 class="text-display-md font-display font-bold text-white mb-4">
                    Stay in the Loop
                </h2>
                <p class="text-lg text-white/60 mb-8">
                    Get our latest articles, case studies, and tech insights delivered straight to your inbox. No spam, unsubscribe anytime.
                </p>

                <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
                    <input 
                        type="email" 
                        placeholder="Enter your email"
                        class="flex-1 px-4 py-3 bg-white/5 border border-white/10 rounded-lg text-white placeholder:text-white/30 focus:outline-none focus:ring-2 focus:ring-cyber-lime/50 focus:border-cyber-lime/50 transition-all"
                        required
                    />
                    <button 
                        type="submit"
                        class="px-6 py-3 bg-cyber-lime text-obsidian font-semibold rounded-lg hover:bg-cyber-lime/90 transition-colors shrink-0"
                    >
                        Subscribe
                    </button>
                </form>
            </div>
        </div>
    </section>

    <Footer />
</Layout>

<script>
    // Category filter functionality - works with Astro View Transitions
    function initBlogFilters() {
        const categoryBtns = document.querySelectorAll('.category-btn');
        const blogCards = document.querySelectorAll('.blog-card');
        const noResults = document.getElementById('no-results');
        const featuredSection = document.querySelector('.featured-section');

        if (!categoryBtns.length) return;

        categoryBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const category = btn.getAttribute('data-category');

                // Update active button styles
                categoryBtns.forEach(b => {
                    b.classList.remove('text-cyber-lime', 'bg-cyber-lime/10', 'border-cyber-lime/30');
                    b.classList.add('text-white/60', 'bg-white/5', 'border-white/10');
                });
                btn.classList.add('text-cyber-lime', 'bg-cyber-lime/10', 'border-cyber-lime/30');
                btn.classList.remove('text-white/60', 'bg-white/5', 'border-white/10');

                // Filter cards with animation
                let visibleCount = 0;
                blogCards.forEach(card => {
                    const cardElement = card as HTMLElement;
                    const cardCategory = card.getAttribute('data-category');
                    
                    if (category === 'all' || cardCategory === category) {
                        cardElement.style.display = '';
                        cardElement.style.opacity = '1';
                        cardElement.style.transform = 'translateY(0)';
                        visibleCount++;
                    } else {
                        cardElement.style.opacity = '0';
                        cardElement.style.transform = 'translateY(10px)';
                        setTimeout(() => {
                            cardElement.style.display = 'none';
                        }, 200);
                    }
                });

                // Hide featured section when filtering
                if (featuredSection) {
                    const featuredEl = featuredSection as HTMLElement;
                    featuredEl.style.display = category === 'all' ? '' : 'none';
                }

                // Show/hide no results message
                if (noResults) {
                    noResults.classList.toggle('hidden', visibleCount > 0);
                }
            });
        });
    }

    // Initialize on page load
    initBlogFilters();
    
    // Re-initialize after View Transitions
    document.addEventListener('astro:after-swap', initBlogFilters);
</script>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .blog-card {
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
    
    .featured-section {
        transition: opacity 0.3s ease;
    }
</style>
