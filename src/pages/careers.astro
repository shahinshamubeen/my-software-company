---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { jobs, departments } from "../data/jobs";

const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Careers" },
];

// Group jobs by department
const jobsByDepartment = departments.map(dept => ({
    department: dept,
    jobs: jobs.filter(job => job.department === dept)
}));
---

<Layout title="Careers" description="Join Apex Labs and build the future of software. We're hiring engineers, designers, and innovators who want to make an impact.">
    {/* Hero */}
    <section class="pt-32 pb-16 relative overflow-hidden">
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-20 left-1/4 w-96 h-96 bg-cyber-lime/20 rounded-full blur-3xl"></div>
        </div>

        <div class="section-container relative z-10">
            <Breadcrumb items={breadcrumbItems} />
            
            <div class="max-w-3xl">
                <span class="inline-block px-4 py-1 mb-6 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full">
                    We're Hiring
                </span>
                
                <h1 class="text-display-xl font-display font-bold text-white mb-6">
                    Join Our Team
                </h1>
                
                <p class="text-xl text-white/60">
                    {jobs.length} open positions across {departments.length} departments. 
                    Find your next adventure with Apex Labs.
                </p>
            </div>
        </div>
    </section>

    {/* Job Listings */}
    <section class="py-16">
        <div class="section-container">
            <div class="space-y-12">
                {jobsByDepartment.map((group) => (
                    <div>
                        <h2 class="text-xl font-display font-semibold text-white mb-6 flex items-center gap-3">
                            <span class="w-8 h-8 rounded-lg bg-electric-indigo/20 text-electric-indigo flex items-center justify-center text-sm font-mono">
                                {group.jobs.length}
                            </span>
                            {group.department}
                        </h2>
                        
                        <div class="space-y-4">
                            {group.jobs.map((job) => (
                                <a 
                                    href={`/careers/${job.id}`}
                                    class="block p-6 rounded-xl glass-card border border-glass-border hover:border-cyber-lime/30 transition-all group"
                                >
                                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                                        <div>
                                            <h3 class="text-xl font-display font-semibold text-white group-hover:text-cyber-lime transition-colors mb-2">
                                                {job.title}
                                            </h3>
                                            <div class="flex flex-wrap items-center gap-3 text-sm text-white/60">
                                                <span class="flex items-center gap-1">
                                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                                    </svg>
                                                    {job.location}
                                                </span>
                                                <span class="px-2 py-0.5 bg-white/5 rounded-full text-xs">
                                                    {job.remote}
                                                </span>
                                                <span class="px-2 py-0.5 bg-white/5 rounded-full text-xs">
                                                    {job.type}
                                                </span>
                                                <span class="text-cyber-lime font-mono">
                                                    {job.salary}
                                                </span>
                                            </div>
                                        </div>
                                        
                                        <div class="flex items-center gap-2 text-white/60 group-hover:text-cyber-lime transition-colors">
                                            <span class="text-sm font-medium">View Role</span>
                                            <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                            </svg>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* CTA */}
    <section class="py-16 border-t border-glass-border">
        <div class="section-container">
            <div class="max-w-2xl mx-auto text-center">
                <h2 class="text-2xl font-display font-bold text-white mb-4">
                    Don't See Your Role?
                </h2>
                <p class="text-white/60 mb-6">
                    We're always looking for exceptional people. Send us your resume.
                </p>
                <a 
                    href="mailto:careers@apexlabs.dev" 
                    class="inline-flex items-center gap-2 btn-brutal"
                >
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    Send General Application
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
