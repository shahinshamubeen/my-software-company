---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm";
import BookingButton from "../components/BookingButton";

// FAQ data
const faqs = [
    {
        question: "What is your typical project timeline?",
        answer: "Project timelines vary based on scope and complexity. MVPs typically take 8-12 weeks, while full-scale platforms can take 4-6 months. We provide detailed timelines during our discovery phase.",
    },
    {
        question: "Do you work with startups or only enterprises?",
        answer: "We work with both. From seed-stage startups building their first MVP to Fortune 500 companies modernizing their tech stack. Our team size and engagement model adapts to your needs.",
    },
    {
        question: "What is your technology stack?",
        answer: "We are stack-agnostic and choose the best tools for your specific needs. Our team has deep expertise in React, Node.js, Python, Go, AWS, GCP, and modern AI/ML frameworks.",
    },
    {
        question: "How do you handle intellectual property?",
        answer: "All code and intellectual property created during the engagement belongs to you. We sign comprehensive IP assignment agreements as part of our standard contract.",
    },
    {
        question: "Can you work with our existing team?",
        answer: "Absolutely. We often embed with client teams, working as an extension of your organization. We adapt to your processes, tools, and communication preferences.",
    },
    {
        question: "What is your pricing model?",
        answer: "We offer both time-and-materials and fixed-bid pricing depending on the project. Use our Project Estimator on the Services page for a preliminary quote.",
    },
];
---

<Layout
    title="Contact"
    description="Get in touch with Apex Labs. Let's discuss your project and see how we can help."
>
    {/* Hero */}
    <section class="pt-32 pb-16">
        <div class="section-container">
            <div class="max-w-4xl mx-auto text-center">
                <span
                    class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full"
                >
                    Let's Talk
                </span>
                <h1
                    class="text-display-lg font-display font-bold text-white mb-6"
                >
                    Start a conversation
                </h1>
                <p class="text-xl text-white/70">
                    Tell us about your project and we'll get back to you within
                    24 hours with our thoughts on how we can help.
                </p>
            </div>
        </div>
    </section>

    {/* Contact Form */}
    <section class="py-16">
        <div class="section-container">
            <div class="max-w-2xl mx-auto">
                <ContactForm client:load />
            </div>
        </div>
    </section>

    {/* Alternative Contact */}
    <section class="py-16 border-t border-glass-border">
        <div class="section-container">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div
                    class="p-6 rounded-xl glass-card border border-glass-border"
                >
                    <div
                        class="w-12 h-12 mx-auto mb-4 rounded-lg bg-cyber-lime/10 border border-cyber-lime/30 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 text-cyber-lime"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                            ></path>
                            <polyline points="22,6 12,13 2,6"></polyline>
                        </svg>
                    </div>
                    <h3 class="font-display font-semibold text-white mb-2">
                        Email
                    </h3>
                    <a
                        href="mailto:hello@apexlabs.dev"
                        class="text-cyber-lime hover:underline"
                    >
                        hello@apexlabs.dev
                    </a>
                </div>

                <div
                    class="p-6 rounded-xl glass-card border border-glass-border"
                >
                    <div
                        class="w-12 h-12 mx-auto mb-4 rounded-lg bg-electric-indigo/10 border border-electric-indigo/30 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 text-electric-indigo"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect
                                x="2"
                                y="3"
                                width="20"
                                height="14"
                                rx="2"
                                ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <h3 class="font-display font-semibold text-white mb-2">
                        Schedule a Call
                    </h3>
                    <BookingButton client:visible />
                </div>

                <div
                    class="p-6 rounded-xl glass-card border border-glass-border"
                >
                    <div
                        class="w-12 h-12 mx-auto mb-4 rounded-lg bg-electric-purple/10 border border-electric-purple/30 flex items-center justify-center"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 text-electric-purple"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"
                            ></path>
                        </svg>
                    </div>
                    <h3 class="font-display font-semibold text-white mb-2">
                        Discord
                    </h3>
                    <a href="#" class="text-electric-purple hover:underline">
                        Join our community
                    </a>
                </div>
            </div>
        </div>
    </section>

    {/* FAQ */}
    <section
        id="faq"
        class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian"
    >
        <div class="section-container">
            <div class="text-center mb-16">
                <span
                    class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-warning-yellow border border-warning-yellow/30 rounded-full"
                >
                    FAQ
                </span>
                <h2
                    class="text-display-md font-display font-bold text-white mb-4"
                >
                    Frequently Asked Questions
                </h2>
            </div>

            <div class="max-w-3xl mx-auto space-y-4">
                {
                    faqs.map((faq, index) => (
                        <details class="group glass-card rounded-xl border border-glass-border overflow-hidden">
                            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                                <span class="font-display font-semibold text-white pr-4">
                                    {faq.question}
                                </span>
                                <span class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full bg-white/5 group-open:bg-cyber-lime/20 transition-colors">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="w-4 h-4 text-white/60 group-open:text-cyber-lime transition-transform group-open:rotate-45"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    >
                                        <line x1="12" y1="5" x2="12" y2="19" />
                                        <line x1="5" y1="12" x2="19" y2="12" />
                                    </svg>
                                </span>
                            </summary>
                            <div class="px-6 pb-6 text-white/60">
                                {faq.answer}
                            </div>
                        </details>
                    ))
                }
            </div>
        </div>
    </section>

    <Footer />
</Layout>
