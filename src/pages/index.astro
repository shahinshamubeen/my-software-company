---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TechStack from "../components/TechStack";
import FeaturedWork from "../components/FeaturedWork.astro";
import ServicesPreview from "../components/ServicesPreview.astro";
import Marquee from "../components/Marquee.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Home">
	<!-- Hero Section -->
	<Hero />

	<!-- Scrolling Marquee -->
	<Marquee />

	<!-- Tech Stack Section -->
	<TechStack client:visible />

	<!-- Featured Work Section -->
	<FeaturedWork />

	<!-- Services Preview Section -->
	<ServicesPreview />

	<!-- Footer -->
	<Footer />

	<!-- Scrollytelling Homepage Toggle -->
	<a
		href="/home2"
		class="fixed bottom-8 left-8 z-50 px-4 py-2 rounded-full glass-card border border-white/20 text-sm font-mono text-white/60 hover:text-white hover:border-cyber-lime transition-all"
	>
		Try Immersive Mode →
	</a>
</Layout>
