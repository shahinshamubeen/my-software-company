---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

const lastUpdated = "April 20, 2026";

const sections = [
  {
    title: "Information we collect",
    body: [
      "Contact details, such as your name, email address, company, and anything you include when you submit a contact form or email us.",
      "Project and business details, such as budget range, services you are interested in, project goals, timelines, and related notes.",
      "Newsletter information, such as your email address and subscription preferences when you sign up for updates.",
      "Applicant information, such as resumes, portfolio links, employment history, and other details you send to our careers address.",
      "Website and device information, such as pages viewed, approximate location, browser/device type, referrer, and interactions with site features, when analytics or marketing cookies are enabled.",
    ],
  },
  {
    title: "How we use information",
    body: [
      "Respond to inquiries, schedule calls, and evaluate whether we can help with your project.",
      "Operate, secure, debug, and improve the website and related services.",
      "Send newsletters or marketing updates when you sign up or otherwise consent.",
      "Measure site performance and understand which pages, content, and calls to action are useful.",
      "Run advertising, retargeting, and campaign measurement only when marketing consent is granted.",
      "Review job or contractor applications and communicate about opportunities.",
      "Comply with legal, tax, security, fraud-prevention, and contractual obligations.",
    ],
  },
  {
    title: "When we share information",
    body: [
      "Service providers that help us host the site, process forms, manage email, schedule calls, analyze traffic, run advertising, or secure our systems.",
      "Professional advisers, such as lawyers, accountants, insurers, or auditors, when reasonably necessary.",
      "Authorities, courts, or other parties when required by law or needed to protect rights, safety, users, or the website.",
      "A buyer, successor, or related party if we are involved in a merger, acquisition, reorganization, financing, or sale of assets.",
    ],
  },
  {
    title: "Retention",
    body: [
      "Contact and project inquiries are kept only as long as needed to respond, manage the relationship, and maintain business records.",
      "Newsletter records are kept until you unsubscribe or ask us to delete them, unless we need limited records for compliance.",
      "Applicant information is kept for a reasonable recruiting period unless a longer period is required or permitted by law.",
      "Analytics and marketing data retention depends on the settings in Google Analytics, Meta, Cookiebot, and related tools.",
    ],
  },
  {
    title: "Your choices and rights",
    body: [
      "You can reopen cookie settings from the footer or the Cookie Policy page and withdraw optional cookie consent at any time.",
      "You can unsubscribe from marketing emails using the unsubscribe link in those emails or by contacting us.",
      "Depending on where you live, you may have rights to access, correct, delete, restrict, port, or object to certain processing of personal information.",
      "Some jurisdictions provide the right to opt out of targeted advertising, sale, or sharing of personal information. Rejecting marketing cookies disables Meta Pixel and similar marketing tools on this site.",
    ],
  },
];
---

<Layout
  title="Privacy Policy"
  description="Learn how WYDGT collects, uses, shares, and protects personal information."
>
  <section class="pt-32 pb-16">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <span
          class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full"
        >
          Privacy Policy
        </span>
        <h1 class="text-display-lg font-display font-bold text-white mb-4">
          Privacy Policy
        </h1>
        <p class="text-white/50 mb-8">Last updated: {lastUpdated}</p>

        <div class="glass-card border border-glass-border rounded-2xl p-6 mb-10">
          <p class="text-white/70 mb-4">
            This Privacy Policy explains how WYDGT collects, uses, discloses,
            and protects information when you visit this website, contact us,
            subscribe to updates, schedule a call, or apply for a role.
          </p>
          <p class="text-white/70">
            For now, WYDGT is used as the website operator name. Before launch,
            confirm the registered legal entity, business address, and privacy
            contact details for your final compliance review.
          </p>
        </div>

        <div class="space-y-8">
          {
            sections.map((section) => (
              <section class="glass-card border border-glass-border rounded-2xl p-6">
                <h2 class="text-2xl font-display font-semibold text-white mb-4">
                  {section.title}
                </h2>
                <ul class="space-y-3 text-white/70">
                  {section.body.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyber-lime" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Cookies, analytics, and advertising
            </h2>
            <div class="space-y-4 text-white/70">
              <p>
                We use Cookiebot to collect and manage consent for optional
                cookies and similar technologies. Necessary technologies may run
                to provide the website and keep it secure.
              </p>
              <p>
                Google Analytics 4 is loaded only after you consent to
                statistics cookies. Meta Pixel is loaded only after you consent
                to marketing cookies.
              </p>
              <p>
                You can review cookie categories, change your preferences, and
                view the cookie declaration on our{" "}
                <a href="/cookies" class="text-cyber-lime hover:underline">
                  Cookie Policy
                </a>.
              </p>
            </div>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              International transfers
            </h2>
            <p class="text-white/70">
              We may use service providers in countries other than yours. When
              required, we use appropriate safeguards such as contractual
              protections, vendor terms, and security controls designed to
              protect personal information.
            </p>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Security
            </h2>
            <p class="text-white/70">
              We use reasonable administrative, technical, and organizational
              safeguards designed to protect personal information. No website,
              transmission, or storage system can be guaranteed to be completely
              secure.
            </p>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Children
            </h2>
            <p class="text-white/70">
              This website is intended for business users and is not directed to
              children. We do not knowingly collect personal information from
              children.
            </p>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Contact and privacy requests
            </h2>
            <div class="space-y-4 text-white/70">
              <p>
                To ask a privacy question or submit a request to access,
                correct, delete, or opt out of certain uses of your information,
                email us at{" "}
                <a
                  href="mailto:hello@wydgt.dev"
                  class="text-cyber-lime hover:underline"
                >
                  hello@wydgt.dev
                </a>.
              </p>
              <p>
                We may need enough information to verify and process your
                request. We will respond within the timeframe required by
                applicable law.
              </p>
            </div>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Changes to this policy
            </h2>
            <p class="text-white/70">
              We may update this Privacy Policy from time to time. The updated
              version will be posted on this page with a revised date.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
