---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ScopeConfigurator from "../components/ScopeConfigurator";
import Footer from "../components/Footer.astro";
import {
  industries,
  popularBuilds,
  serviceCategories,
} from "../data/serviceCatalog";

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Services" }];

const iconPaths: Record<string, string> = {
  globe:
    '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/>',
  panels:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/><path d="M9 20V10"/>',
  phone:
    '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
  building:
    '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9h1"/><path d="M9 13h1"/><path d="M9 17h1"/>',
  cart:
    '<circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/><path d="M3 4h2l2.4 10.5a2 2 0 0 0 2 1.5h7.8a2 2 0 0 0 1.9-1.4L21 8H6"/>',
  bot:
    '<rect x="4" y="8" width="16" height="10" rx="2"/><path d="M12 4v4"/><path d="M8 12h.01"/><path d="M16 12h.01"/><path d="M9 16h6"/>',
  cloud:
    '<path d="M17.5 19H8a6 6 0 1 1 5.6-8.1A4.5 4.5 0 1 1 17.5 19Z"/><path d="M12 13v4"/><path d="m9 15 3-3 3 3"/>',
  spark:
    '<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"/><path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"/>',
};
---

<Layout
  title="Services"
  description="Explore WYDGT services for business websites, web apps, mobile apps, ERP, CRM, HRMS, ecommerce, AI automation, cloud infrastructure, and software maintenance."
>
  <section class="pt-32 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-20" aria-hidden="true"></div>
    <div
      class="absolute -top-24 right-1/4 h-72 w-72 rounded-full bg-cyber-lime/10 blur-[120px]"
      aria-hidden="true"
    >
    </div>

    <div class="section-container relative">
      <Breadcrumb items={breadcrumbItems} />

      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-10 items-end">
        <div>
          <span
            class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-electric-indigo border border-electric-indigo/30 rounded-full"
          >
            Full-Service Software Partner
          </span>
          <h1 class="text-display-lg font-display font-bold text-white mb-5">
            Services for every stage of your digital business
          </h1>
          <p class="max-w-3xl text-lg text-white/70">
            We build business websites, web apps, iOS and Android apps, ERP,
            CRM, HRMS, ecommerce platforms, automations, integrations, cloud
            infrastructure, and long-term product improvements.
          </p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-6">
          <div class="grid grid-cols-3 gap-4">
            <div>
              <span class="block text-4xl font-mono font-bold text-cyber-lime">
                08
              </span>
              <span class="text-xs uppercase tracking-wide text-white/45">
                service areas
              </span>
            </div>
            <div>
              <span class="block text-4xl font-mono font-bold text-electric-indigo">
                16
              </span>
              <span class="text-xs uppercase tracking-wide text-white/45">
                build types
              </span>
            </div>
            <div>
              <span class="block text-4xl font-mono font-bold text-electric-purple">
                10
              </span>
              <span class="text-xs uppercase tracking-wide text-white/45">
                industries
              </span>
            </div>
          </div>
          <div class="mt-6 flex flex-wrap gap-2">
            {
              serviceCategories.slice(0, 4).map((service) => (
                <a
                  href={`#${service.id}`}
                  class="rounded-full border border-white/10 bg-obsidian/60 px-3 py-1.5 text-xs text-white/65 transition-colors hover:border-white/25 hover:text-white"
                >
                  {service.title}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20">
    <div class="section-container">
      <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-5 md:p-6">
        <div class="mb-5 flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-cyber-lime">
              Common Requests
            </span>
            <h2 class="mt-2 text-2xl font-display font-bold text-white">
              Popular builds we can deliver
            </h2>
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 text-sm text-white/60 transition-colors hover:text-cyber-lime"
          >
            Talk to us
            <svg
              class="h-4 w-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <div class="flex flex-wrap gap-2">
          {
            popularBuilds.map((build) => (
              <span class="rounded-full border border-white/10 bg-obsidian/60 px-3 py-1.5 text-sm text-white/65">
                {build}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian">
    <div class="section-container">
      <div class="mb-14 max-w-3xl">
        <span
          class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-electric-purple border border-electric-purple/30 rounded-full"
        >
          Service Catalog
        </span>
        <h2 class="text-display-md font-display font-bold text-white mb-4">
          Pick the category closest to your need
        </h2>
        <p class="text-white/65">
          Each category can be delivered as a fresh build, a redesign, an
          integration project, or an ongoing improvement retainer.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {
          serviceCategories.map((service, index) => (
            <article
              id={service.id}
              class="scroll-mt-28 relative overflow-hidden rounded-2xl border border-white/10 bg-black/35 p-6 md:p-8"
              style={`--service-color: ${service.color}`}
            >
              <div
                class="absolute inset-x-0 top-0 h-1"
                style={`background: ${service.color}`}
              />
              <div
                class="absolute -right-20 -top-20 h-48 w-48 rounded-full opacity-25 blur-[80px]"
                style={`background: ${service.color}`}
                aria-hidden="true"
              />

              <div class="relative">
                <div class="mb-6 flex items-start justify-between gap-5">
                  <div class="flex items-center gap-4">
                    <div
                      class="flex h-14 w-14 items-center justify-center rounded-xl border bg-white/[0.03]"
                      style={`border-color: ${service.color}55; color: ${service.color}; background: ${service.color}10`}
                    >
                      <svg
                        class="h-7 w-7"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <Fragment set:html={iconPaths[service.icon]} />
                      </svg>
                    </div>
                    <div>
                      <span
                        class="text-xs font-mono uppercase tracking-widest"
                        style={`color: ${service.color}`}
                      >
                        {service.eyebrow}
                      </span>
                      <h3 class="mt-1 text-2xl font-display font-semibold text-white">
                        {service.title}
                      </h3>
                    </div>
                  </div>
                  <span class="font-mono text-sm text-white/25">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                </div>

                <p class="text-white/65 leading-relaxed">
                  {service.description}
                </p>

                <div class="mt-6 flex flex-wrap gap-2">
                  {service.examples.map((example) => (
                    <span class="rounded-lg border border-white/10 bg-white/[0.04] px-2.5 py-1 text-xs text-white/60">
                      {example}
                    </span>
                  ))}
                </div>

                <div class="mt-8 grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] gap-6">
                  <div>
                    <h4 class="mb-3 text-sm font-mono uppercase tracking-widest text-white/40">
                      Includes
                    </h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      {service.includes.map((item) => (
                        <div class="flex items-start gap-3 text-sm text-white/65">
                          <span
                            class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full"
                            style={`background: ${service.color}`}
                          />
                          <span>{item}</span>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div>
                    <h4 class="mb-3 text-sm font-mono uppercase tracking-widest text-white/40">
                      Outcomes
                    </h4>
                    <div class="space-y-2">
                      {service.outcomes.map((outcome) => (
                        <div
                          class="rounded-lg border px-3 py-2 text-sm"
                          style={`border-color: ${service.color}33; color: ${service.color}; background: ${service.color}0D`}
                        >
                          {outcome}
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="industries" class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-15" aria-hidden="true"></div>
    <div class="section-container relative">
      <div class="mb-12 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span
            class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full"
          >
            Industries
          </span>
          <h2 class="text-display-md font-display font-bold text-white">
            Software shaped around your sector
          </h2>
        </div>
        <p class="max-w-xl text-white/60">
          Most projects combine a service category with an industry workflow,
          like ecommerce for retail, HRMS for manufacturing, or booking systems
          for hospitality.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {
          industries.map((industry) => (
            <div class="rounded-2xl border border-white/10 bg-black/30 p-5 transition-colors hover:border-white/20 hover:bg-white/[0.03]">
              <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03]">
                <span
                  class="h-3 w-3 rounded-full shadow-[0_0_18px_currentColor]"
                  style={`color: ${industry.color}; background: ${industry.color}`}
                />
              </div>
              <h3 class="font-display font-semibold text-white">
                {industry.name}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-white/55">
                {industry.summary}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian">
    <div class="section-container">
      <div class="text-center mb-12">
        <span
          class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-warning-yellow border border-warning-yellow/30 rounded-full"
        >
          Get Started
        </span>
        <h2 class="text-display-md font-display font-bold text-white mb-4">
          Project Estimator
        </h2>
        <p class="max-w-2xl mx-auto text-white/60">
          Configure your project requirements and get an instant estimate. No
          commitment required.
        </p>
      </div>

      <ScopeConfigurator client:visible />
    </div>
  </section>

  <Footer />
</Layout>
