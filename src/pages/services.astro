---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import ScopeConfigurator from "../components/ScopeConfigurator";
import Footer from "../components/Footer.astro";

// Breadcrumb items
const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Services" },
];

// Services data
const services = [
    {
        id: "product-development",
        title: "Product Development",
        description:
            "End-to-end development from concept to launch, building scalable products that users love.",
        longDescription:
            "We partner with you from ideation to deployment, creating digital products that solve real problems. Our full-stack teams combine deep technical expertise with product thinking to deliver solutions that scale.",
        icon: "rocket",
        color: "#00FF9D",
        features: [
            {
                title: "MVP Development",
                desc: "Validate your idea with a minimum viable product in weeks, not months.",
            },
            {
                title: "Full-Stack Engineering",
                desc: "Frontend, backend, and everything in between with modern tech stacks.",
            },
            {
                title: "API Design",
                desc: "RESTful and GraphQL APIs built for performance and developer experience.",
            },
            {
                title: "System Architecture",
                desc: "Scalable architectures designed for growth from day one.",
            },
        ],
        technologies: [
            "React",
            "Next.js",
            "Node.js",
            "PostgreSQL",
            "Redis",
            "Docker",
        ],
    },
    {
        id: "ai-integration",
        title: "AI Integration",
        description:
            "Leverage cutting-edge AI to automate workflows, enhance user experiences, and unlock insights.",
        longDescription:
            "From GPT-powered chatbots to custom machine learning models, we help you harness AI to create competitive advantages and automate complex processes.",
        icon: "brain",
        color: "#6366F1",
        features: [
            {
                title: "LLM Integration",
                desc: "Integrate OpenAI, Anthropic, or open-source models into your products.",
            },
            {
                title: "Custom Models",
                desc: "Train and deploy models tailored to your specific use case.",
            },
            {
                title: "Data Pipelines",
                desc: "Build robust ETL pipelines to fuel your AI systems.",
            },
            {
                title: "Vector Databases",
                desc: "Implement semantic search and RAG architectures.",
            },
        ],
        technologies: [
            "OpenAI",
            "LangChain",
            "Python",
            "TensorFlow",
            "Pinecone",
            "Hugging Face",
        ],
    },
    {
        id: "cloud-infrastructure",
        title: "Cloud & DevOps",
        description:
            "Design and implement cloud infrastructure that scales automatically and costs less.",
        longDescription:
            "We architect cloud-native solutions that are secure, scalable, and cost-efficient. Our DevOps practices ensure rapid, reliable deployments.",
        icon: "cloud",
        color: "#BF00FF",
        features: [
            {
                title: "Cloud Architecture",
                desc: "AWS, GCP, or Azure solutions designed for your needs.",
            },
            {
                title: "Kubernetes",
                desc: "Container orchestration for maximum flexibility and scale.",
            },
            {
                title: "CI/CD Pipelines",
                desc: "Automated testing and deployment for rapid iteration.",
            },
            {
                title: "Monitoring & Observability",
                desc: "Real-time insights into system health and performance.",
            },
        ],
        technologies: [
            "AWS",
            "GCP",
            "Kubernetes",
            "Terraform",
            "GitHub Actions",
            "Datadog",
        ],
    },
    {
        id: "mobile-apps",
        title: "Mobile Apps",
        description:
            "Native and cross-platform mobile applications with stunning UI and smooth performance.",
        longDescription:
            "We craft mobile experiences that users love. Whether native or cross-platform, we deliver apps that feel at home on any device.",
        icon: "phone",
        color: "#FF9900",
        features: [
            {
                title: "React Native",
                desc: "Cross-platform apps with native performance.",
            },
            {
                title: "Flutter",
                desc: "Beautiful, fast apps for iOS and Android from a single codebase.",
            },
            {
                title: "iOS Native",
                desc: "Swift-powered apps that leverage the full Apple ecosystem.",
            },
            {
                title: "Android Native",
                desc: "Kotlin apps optimized for the Android platform.",
            },
        ],
        technologies: [
            "React Native",
            "Flutter",
            "Swift",
            "Kotlin",
            "Firebase",
            "Expo",
        ],
    },
];
---

<Layout
    title="Services"
    description="Explore our comprehensive software development services including product development, AI integration, cloud infrastructure, and mobile apps."
>
    {/* Hero Section */}
    <section class="pt-32 pb-16">
        <div class="section-container">
            {/* Breadcrumb */}
            <Breadcrumb items={breadcrumbItems} />
            
            <div class="text-center mb-16">
                <span
                    class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-electric-indigo border border-electric-indigo/30 rounded-full"
                >
                    What We Offer
                </span>
                <h1
                    class="text-display-lg font-display font-bold text-white mb-4"
                >
                    Our Services
                </h1>
                <p class="max-w-2xl mx-auto text-white/70">
                    From initial concept to production scale, we provide
                    comprehensive engineering services to transform your vision
                    into reality.
                </p>
            </div>
        </div>
    </section>

    {/* Services Detail */}
    {
        services.map((service, index) => (
            <section
                id={service.id}
                class={`py-24 ${index % 2 === 0 ? "bg-gradient-to-b from-obsidian via-carbon to-obsidian" : ""}`}
            >
                <div class="section-container">
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                        {/* Content */}
                        <div class={index % 2 === 1 ? "lg:order-2" : ""}>
                            <span
                                class="inline-block px-3 py-1 mb-4 text-xs font-mono uppercase tracking-widest rounded-full border"
                                style={`color: ${service.color}; border-color: ${service.color}40`}
                            >
                                0{index + 1}
                            </span>
                            <h2 class="text-display-md font-display font-bold text-white mb-4">
                                {service.title}
                            </h2>
                            <p class="text-lg text-white/60 mb-8">
                                {service.longDescription}
                            </p>

                            {/* Features */}
                            <div class="space-y-4 mb-8">
                                {service.features.map((feature) => (
                                    <div class="flex gap-4">
                                        <span
                                            class="mt-1.5 w-2 h-2 rounded-full flex-shrink-0"
                                            style={`background: ${service.color}`}
                                        />
                                        <div>
                                            <h3 class="font-semibold text-white">
                                                {feature.title}
                                            </h3>
                                            <p class="text-sm text-white/50">
                                                {feature.desc}
                                            </p>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            {/* Technologies */}
                            <div class="flex flex-wrap gap-2">
                                {service.technologies.map((tech) => (
                                    <span class="px-3 py-1 text-xs font-mono text-white/60 bg-white/5 border border-white/10 rounded-lg">
                                        {tech}
                                    </span>
                                ))}
                            </div>
                        </div>

                        {/* Visual */}
                        <div
                            class={`relative ${index % 2 === 1 ? "lg:order-1" : ""}`}
                        >
                            <div
                                class="aspect-square rounded-2xl glass-card p-8 relative overflow-hidden"
                                style={`background: linear-gradient(135deg, ${service.color}10, transparent)`}
                            >
                                <div class="absolute inset-0 grid-lines opacity-30" />
                                <div class="absolute inset-0 flex items-center justify-center">
                                    <div
                                        class="w-32 h-32 rounded-3xl border-2 flex items-center justify-center"
                                        style={`border-color: ${service.color}; background: ${service.color}10`}
                                    >
                                        <span
                                            class="text-6xl font-mono font-bold"
                                            style={`color: ${service.color}`}
                                        >
                                            0{index + 1}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        ))
    }

    {/* Scope Configurator Section */}
    <section
        class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian"
    >
        <div class="section-container">
            <div class="text-center mb-12">
                <span
                    class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-warning-yellow border border-warning-yellow/30 rounded-full"
                >
                    Get Started
                </span>
                <h2
                    class="text-display-md font-display font-bold text-white mb-4"
                >
                    Project Estimator
                </h2>
                <p class="max-w-2xl mx-auto text-white/60">
                    Configure your project requirements and get an instant
                    estimate. No commitment required.
                </p>
            </div>

            <ScopeConfigurator client:visible />
        </div>
    </section>

    <Footer />
</Layout>
