---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";

const lastUpdated = "April 20, 2026";

const sections = [
  {
    title: "Using the website",
    body: [
      "You may use this website only for lawful purposes and in accordance with these Terms.",
      "You may not interfere with the security, availability, or operation of the website.",
      "You may not attempt to scrape, copy, reverse engineer, or misuse the website in a way that violates law or harms WYDGT, users, or third parties.",
    ],
  },
  {
    title: "Website content",
    body: [
      "The content on this website is provided for general informational and marketing purposes.",
      "Case studies, estimates, service descriptions, timelines, and pricing examples are illustrative unless a signed agreement says otherwise.",
      "We may update, remove, or change website content at any time without notice.",
    ],
  },
  {
    title: "Intellectual property",
    body: [
      "The website, brand elements, designs, copy, graphics, components, and other materials are owned by WYDGT or its licensors unless otherwise stated.",
      "You may not copy, distribute, modify, or create derivative works from website materials without written permission, except as permitted by law.",
      "Client project intellectual property is handled through separate signed agreements, not these website Terms.",
    ],
  },
  {
    title: "Third-party links and services",
    body: [
      "The website may link to third-party services such as scheduling tools, social platforms, analytics providers, or content tools.",
      "We do not control those third-party services and are not responsible for their content, terms, security, privacy practices, or availability.",
      "Your use of third-party services is governed by their own terms and policies.",
    ],
  },
  {
    title: "No professional advice",
    body: [
      "Website content is not legal, financial, security, tax, or professional advice.",
      "You should evaluate whether our services, content, and recommendations are appropriate for your situation before relying on them.",
    ],
  },
  {
    title: "Disclaimers",
    body: [
      "The website is provided on an as-is and as-available basis.",
      "We do not guarantee that the website will be uninterrupted, secure, error-free, or free of harmful components.",
      "To the fullest extent permitted by law, we disclaim warranties of merchantability, fitness for a particular purpose, non-infringement, and any warranties arising from course of dealing or usage of trade.",
    ],
  },
  {
    title: "Limitation of liability",
    body: [
      "To the fullest extent permitted by law, WYDGT and its team will not be liable for indirect, incidental, consequential, special, exemplary, or punitive damages arising from your use of the website.",
      "To the fullest extent permitted by law, our total liability for website-related claims will not exceed the amount you paid us, if any, for accessing the website.",
      "Some jurisdictions do not allow certain limitations, so some of these limitations may not apply to you.",
    ],
  },
];
---

<Layout
  title="Terms of Service"
  description="Read the terms that apply when you use the WYDGT website."
>
  <section class="pt-32 pb-16">
    <div class="section-container">
      <div class="max-w-4xl mx-auto">
        <span
          class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-cyber-lime border border-cyber-lime/30 rounded-full"
        >
          Terms
        </span>
        <h1 class="text-display-lg font-display font-bold text-white mb-4">
          Terms of Service
        </h1>
        <p class="text-white/50 mb-8">Last updated: {lastUpdated}</p>

        <div class="glass-card border border-glass-border rounded-2xl p-6 mb-10">
          <p class="text-white/70 mb-4">
            These Terms of Service govern your access to and use of this WYDGT
            website. By using the website, you agree to these Terms.
          </p>
          <p class="text-white/70">
            These Terms apply only to the public website. Client services,
            deliverables, payments, confidentiality, support, warranties, and IP
            ownership for paid work should be governed by a separate signed
            agreement.
          </p>
        </div>

        <div class="space-y-8">
          {
            sections.map((section) => (
              <section class="glass-card border border-glass-border rounded-2xl p-6">
                <h2 class="text-2xl font-display font-semibold text-white mb-4">
                  {section.title}
                </h2>
                <ul class="space-y-3 text-white/70">
                  {section.body.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyber-lime" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Inquiries, estimates, and project discussions
            </h2>
            <div class="space-y-4 text-white/70">
              <p>
                Submitting a contact form, booking a call, or discussing a
                project does not create a client relationship, exclusivity,
                confidentiality obligation, or commitment to perform work unless
                we both sign a separate agreement.
              </p>
              <p>
                If you share confidential information before an agreement is in
                place, you do so at your own risk. We recommend using a signed
                NDA before sharing sensitive technical, commercial, or personal
                information.
              </p>
            </div>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Privacy and cookies
            </h2>
            <p class="text-white/70">
              Our collection and use of information is described in our{" "}
              <a href="/privacy" class="text-cyber-lime hover:underline">
                Privacy Policy
              </a>{" "}
              and{" "}
              <a href="/cookies" class="text-cyber-lime hover:underline">
                Cookie Policy
              </a>.
            </p>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Governing law and disputes
            </h2>
            <div class="space-y-4 text-white/70">
              <p>
                These Terms are governed by the laws applicable to the WYDGT
                entity operating this website, unless applicable law requires a
                different rule.
              </p>
              <p>
                Before launch, confirm the registered legal entity, governing
                law, venue, and dispute-resolution process with counsel and
                update this section if needed.
              </p>
            </div>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Changes to these Terms
            </h2>
            <p class="text-white/70">
              We may update these Terms from time to time. The updated version
              will be posted on this page with a revised date.
            </p>
          </section>

          <section class="glass-card border border-glass-border rounded-2xl p-6">
            <h2 class="text-2xl font-display font-semibold text-white mb-4">
              Contact
            </h2>
            <p class="text-white/70">
              Questions about these Terms can be sent to{" "}
              <a
                href="mailto:hello@wydgt.dev"
                class="text-cyber-lime hover:underline"
              >
                hello@wydgt.dev
              </a>.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
