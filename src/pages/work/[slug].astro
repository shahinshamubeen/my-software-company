---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Scrollytelling from "../../components/Scrollytelling";
import RelatedProjects from "../../components/RelatedProjects";
import {
  caseStudies,
  getCaseStudy,
  type CaseStudy,
} from "../../data/caseStudies";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";

export const getStaticPaths = (async () => {
  return caseStudies.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { study } = Astro.props as Props;

// Find next/prev projects for navigation
const currentIndex = caseStudies.findIndex((s) => s.id === study.id);
const prevProject = caseStudies[currentIndex - 1];
const nextProject = caseStudies[currentIndex + 1];

// Breadcrumb items
const breadcrumbItems = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work" },
  { label: study.title },
];
---

<Layout title={study.title} description={study.longDescription}>
  {/* Hero */}
  <section class="pt-32 pb-16 relative overflow-hidden">
    {/* Background */}
    <div
      class="absolute inset-0 opacity-20"
      style={`background: radial-gradient(ellipse at top, ${study.color}30, transparent 70%)`}
    >
    </div>

    <div class="section-container relative z-10">
      {/* Breadcrumb Navigation */}
      <Breadcrumb items={breadcrumbItems} />

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        {/* Content */}
        <div>
          <span
            class="inline-block px-3 py-1 mb-4 text-xs font-mono uppercase tracking-widest rounded-full border"
            style={`color: ${study.color}; border-color: ${study.color}40`}
          >
            {study.category}
          </span>

          <h1
            class="text-display-lg font-display font-bold text-white mb-6"
            transition:name={`project-title-${study.id}`}
          >
            {study.title}
          </h1>

          <p class="text-xl text-white/60 mb-8">
            {study.longDescription}
          </p>

          {/* Tags */}
          <div class="flex flex-wrap gap-2 mb-8">
            {
              study.tags.map((tag) => (
                <span class="px-3 py-1 text-sm font-mono text-white/60 bg-white/5 border border-white/10 rounded-lg">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        {/* Hero Image/Placeholder */}
        <div
          class="aspect-video rounded-2xl overflow-hidden relative"
          transition:name={`project-hero-${study.id}`}
        >
          <div
            class="absolute inset-0"
            style={`background: linear-gradient(135deg, ${study.color}30, ${study.color}10)`}
          >
          </div>
          <div class="absolute inset-0 grid-lines opacity-50"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <span
              class="text-8xl font-display font-bold opacity-20"
              style={`color: ${study.color}`}
            >
              {study.title.split(" ")[0]}
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Results */}
  <section class="py-16 border-y border-glass-border">
    <div class="section-container">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {
          study.results.map((result) => (
            <div class="text-center">
              <span
                class="block text-4xl md:text-5xl font-bold font-mono"
                style={`color: ${study.color}`}
              >
                {result.value}
              </span>
              {result.change && (
                <span class="block text-sm text-green-400 font-mono">
                  {result.change}
                </span>
              )}
              <span class="text-sm text-white/50 uppercase tracking-wide">
                {result.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* Challenge & Solution */}
  <section class="py-24">
    <div class="section-container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div
          class="p-8 rounded-2xl bg-danger-red/5 border border-danger-red/20"
        >
          <span
            class="text-sm font-mono uppercase tracking-wider text-danger-red"
          >
            The Challenge
          </span>
          <p class="mt-4 text-lg text-white/80 leading-relaxed">
            {study.challenge}
          </p>
        </div>

        <div
          class="p-8 rounded-2xl border"
          style={`background: ${study.color}05; border-color: ${study.color}20`}
        >
          <span
            class="text-sm font-mono uppercase tracking-wider"
            style={`color: ${study.color}`}
          >
            Our Solution
          </span>
          <p class="mt-4 text-lg text-white/80 leading-relaxed">
            {study.solution}
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Scrollytelling */}
  <section class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian">
    <div class="section-container">
      <div class="text-center mb-16">
        <span
          class="inline-block px-4 py-1 mb-4 text-xs font-mono uppercase tracking-widest text-white/60 border border-white/20 rounded-full"
        >
          The Journey
        </span>
        <h2 class="text-display-md font-display font-bold text-white">
          How We Built It
        </h2>
      </div>
    </div>

    <Scrollytelling
      client:visible
      projectName={study.title}
      projectColor={study.color}
      slides={study.slides}
    />
  </section>

  {/* Testimonial */}
  {
    study.testimonial && (
      <section class="py-24">
        <div class="section-container">
          <div class="max-w-4xl mx-auto text-center">
            <svg
              class="w-16 h-16 mx-auto mb-8 opacity-20"
              style={`color: ${study.color}`}
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>

            <blockquote class="text-2xl md:text-3xl font-display font-medium text-white leading-relaxed mb-8">
              "{study.testimonial.quote}"
            </blockquote>

            <div class="flex items-center justify-center gap-4">
              <div
                class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-obsidian"
                style={`background: ${study.color}`}
              >
                {study.testimonial.author
                  .split(" ")
                  .map((n) => n[0])
                  .join("")}
              </div>
              <div class="text-left">
                <div class="font-semibold text-white">
                  {study.testimonial.author}
                </div>
                <div class="text-sm text-white/60">
                  {study.testimonial.role}, {study.testimonial.company}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {/* Navigation */}
  <section class="py-16 border-t border-glass-border">
    <div class="section-container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {
          prevProject ? (
            <a
              href={`/work/${prevProject.id}`}
              class="group p-6 rounded-xl glass-card border border-glass-border hover:border-white/20 transition-all"
            >
              <span class="text-sm text-white/40">← Previous</span>
              <h3 class="mt-2 text-xl font-display font-semibold text-white group-hover:text-cyber-lime transition-colors">
                {prevProject.title}
              </h3>
              <span class="text-sm text-white/60">{prevProject.category}</span>
            </a>
          ) : (
            <div />
          )
        }

        {
          nextProject && (
            <a
              href={`/work/${nextProject.id}`}
              class="group p-6 rounded-xl glass-card border border-glass-border hover:border-white/20 transition-all text-right"
            >
              <span class="text-sm text-white/40">Next →</span>
              <h3 class="mt-2 text-xl font-display font-semibold text-white group-hover:text-cyber-lime transition-colors">
                {nextProject.title}
              </h3>
              <span class="text-sm text-white/60">{nextProject.category}</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  {/* Related Projects */}
  <RelatedProjects
    client:visible
    currentId={study.id}
    currentCategory={study.category}
    projects={caseStudies}
  />

  {/* CTA */}
  <section class="py-24 bg-gradient-to-b from-obsidian via-carbon to-obsidian">
    <div class="section-container">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-display-md font-display font-bold text-white mb-6">
          Ready to build something like this?
        </h2>
        <p class="text-xl text-white/60 mb-8">
          Let's discuss how we can help you achieve similar results.
        </p>
        <a href="/contact" class="btn-brutal text-lg"> Start a Conversation </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Add danger-red color utility */
  .text-danger-red {
    color: #ff4444;
  }
  .bg-danger-red\/5 {
    background-color: rgba(255, 68, 68, 0.05);
  }
  .border-danger-red\/20 {
    border-color: rgba(255, 68, 68, 0.2);
  }
</style>
